# Extraction provider: codex (uses `codex login`) or claude (uses ANTHROPIC_API_KEY).
# codex/claude
LABSYNC_PROVIDER=codex
ANTHROPIC_API_KEY=


# pyannote Hugging Face Token
HF_TOKEN=


# Supabase URL
DATABASE_URL=

# OpenAI API key
OPENAI_API_KEY=

# Supabase Auth. The server accepts only tokens issued by this project.
SUPABASE_URL=
# Only for projects that sign tokens with the legacy JWT secret (local Supabase does).
SUPABASE_JWT_SECRET=
# Public anon key. The server doesn't use it; scripts/setup_tunnel.sh copies it into the app.
SUPABASE_ANON_KEY=