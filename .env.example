# Shared bearer token; the iOS LabSyncConfig.plist APIToken must match.
API_SECRET_KEY=

# Extraction provider: codex (uses `codex login`) or claude (uses ANTHROPIC_API_KEY).
# codex/claude
LABSYNC_PROVIDER=codex    
ANTHROPIC_API_KEY=


# pyannote Hugging Face Token
HF_TOKEN=


# Supabase URL
DATABASE_URL=

# OpenAI API key
OPENAI_API_KEY=