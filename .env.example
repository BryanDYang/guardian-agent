# Extraction provider: codex (uses `codex login`) or claude (uses ANTHROPIC_API_KEY).
# codex/claude
LABSYNC_PROVIDER=codex
# Optional executable path for a verified Codex CLI; blank uses codex on PATH.
LABSYNC_CODEX_CLI=
ANTHROPIC_API_KEY=


# pyannote Hugging Face Token
HF_TOKEN=


# Supabase URL
DATABASE_URL=

# OpenAI API key
OPENAI_API_KEY=

# Supabase Auth. The server accepts only tokens issued by this project.
SUPABASE_URL=
# Only for projects that sign tokens with the legacy JWT secret (local Supabase does).
SUPABASE_JWT_SECRET=
# Public anon key. The server doesn't use it; scripts/setup_tunnel.sh copies it into the app.
SUPABASE_ANON_KEY=

# Optional shared mode only. Privileged server key, never an iOS/public key.
SUPABASE_SERVICE_ROLE_KEY=
# Unique per process/host (e.g. bryan-mac, will-mac).
LABSYNC_WORKER_ID=

# Task follow-up delivery. capture stores previews in the app without sending.
# Set resend only after configuring a verified sender and testing recipient access.
LABSYNC_EMAIL_MODE=capture
RESEND_API_KEY=
LABSYNC_EMAIL_FROM=
